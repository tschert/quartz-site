le assignment in a similar way as in the game above.\par \par }{\fs20\lang2057 {\pict\wmetafile8\picw11959\pich7549\picwgoal6780\pichgoal4280 010009000003740200000400620000000000050000000b0200000000050000000c02d60053010400000004010d00040000002e011800040000000201010005000000090200000000050000000102ffffff00030000001e000a00000026060f000a00ffffffff0000000000000a00000026060f000a00ffffffff00000000000007000000fc020100000000000000040000002d01000008000000fa0206000100000000000000040000002d0101006200000024032f007a00bc008e00bf009f00c200ad00c300b800c200c100c000c700bd00cb00b900ce00b400cf00a800cd009800ca008700c9007500c7006000c4005600bf004d00b9004400b1003c00a70036009c00310089002b0075002800600027004d0027003b0028002c002a0021002d001e002f001c00310017003800140040001200500013006000180070001e007f0025008d002b009a003000a5003500ac003e00b2004a00b6005800b9006400ba006f00bb007700bb007900bb007a00bc000a00000026060f000a00ffffffff000000000000040000000701010058000000430fc6008800000019001500000006001900150034002300280000002000000019000000010001000000000000000000120b0000120b0000000000000000000000000000ffffff00fe00fffffe001ffffe7f0ffffe6dc7fffcff63fffcfff0fffcfbd87ffcbff03ffc7f713ffcefe31ffe5fc01ffe3b8d9fff370d9fff0e601fff986d9fff820d1fffc3603fffd86d3fffc3043fffe1607ffff8007ffffe063fffffff3fffffff3fffffff7f07000000fc020000000000000000040000002d01020007000000180454005c004d005500070000001804840070007d0069000700000018046800980061009100040000002d0100000700000018046a009a005e008e00040000002d0102000700000018047f00950078008e00040000002d0100000700000018048100970075008b00040000002d010200070000001804950087008e008000040000002d010000070000001804980089008c007d00040000002d010200070000001804af00ae00a800a700040000002d010000070000001804b100b000a500a400040000002d0102000700000018046e003a0067003300040000002d01000007000000180470003c0064003000040000002d0102000700000018044000700039006900040000002d0100000700000018044300720037006600040000002d010200070000001804730059006c005200040000002d01000007000000180476005b006a004f0