pn\widctlpar\outlinelevel2\adjustright \b\lang1031\cgrid {\lang2057 {\*\bkmkstart _Toc384011268}Different Forms of Linking Ratings with Functional Elements and Roles{\*\bkmkend _Toc384011268} \par }\pard\plain \qj\widctlpar\tx284\adjustright \lang1031\cgrid {\lang2057 Ratings may refer to different aspects of contributions. Therefore different forms of rating units may be used: e.g. a rating unit for innovative ideas: "light-bulbs" If a contribution gets three "bulbs" it is supposed to contain a lot of brilliant, new thoughts. \par }\pard \qj\widctlpar\tx567\adjustright {\lang2057 Another rating unit - e.g. hearts - could be awarded for sympathetic contributions, a third one - maybe medals - for social competence, and so on.\par }\pard \qj\widctlpar\adjustright {\lang2057 \par \tab \tab \tab \tab \tab }{\fs20\lang2057 {\pict\wmetafile8\picw600\pich811\picwgoal340\pichgoal460 0100090000038b0000000000540000000000050000000b02d400e900050000000c02170011000400000004010d00040000002e011800040000000201010005000000090200000000050000000102ffffff00030000001e00040000000701010054000000430f2000cc000000170011000000010017001100d400e900280000001800000017000000010001000000000000000000120b0000120b0000000000000000000000000000ffffff00f0ffffffe07fffffe03fffffe7bfffffe41ffffff1dfffffe607ffffe1e3ffffe7f1ffffc61cffffce4e7fffcffe3fff9fff3fff9fff3fff9fff3fff9fff3fff9fff3fffcffe7fffcffe7fffe7fcfffff1f1fffff807fffffe1fffff040000002701ffff0300000000007fff9fff3fff9fff3fff9fff3fff9fff3fff9fff3fffcffe3fffce4e7fffc61cffffe7f1ffffe1e3ffff0000d2008b00cc00040000002d0100000700000018049a00c5009400bf00040000002d0103000700000018049a00d2009400cc0010000000fb02f6ff00000000000090010000000000000020417269616c000832040000002d01040009000000000505006d6162656c00700078000a00000026060f000a00ffffffff0000000000}}{\lang2057  }{\fs20\lang2057 {\pict\wmetafile8\picw1094\pich953\picwgoal620\pichgoal540 0100090000039300000000005c0000000000050000000b02fa00a900050000000c021b001f000400000004010d00040000002e01180004000